{
  "name": "ai-annotator",
  "displayName": "AI Annotator",
  "description": "Enterprise AI Code Detection, Annotation, Tracking, Policy Enforcement & Analytics",
  "version": "3.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",

  "contributes": {
    "commands": [
      {
        "command": "ai.resetId",
        "title": "AI Annotator: Reset Employee ID"
      },
      {
        "command": "ai.showReport",
        "title": "AI Annotator: Open Dashboard"
      },
      {
        "command": "ai.installHook",
        "title": "AI Annotator: Install Pre-commit Policy Hook"
      },
      {
        "command": "ai.verifyAudit",
        "title": "AI Annotator: Verify Audit Log Integrity"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "ai.resetId" },
        { "command": "ai.showReport" },
        { "command": "ai.installHook" },
        { "command": "ai.verifyAudit" }
      ]
    }
  },

  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },

  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0"
  }
}
